<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="36dp">

    <TextView
        android:id="@+id/editorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_edit_title"
        android:textColor="@color/sv_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/inputName"
        style="@style/SvEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/profile_name_hint"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:nextFocusDown="@id/categoryGrid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editorTitle" />

    <TextView
        android:id="@+id/categoryLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/profile_categories"
        android:textColor="@color/sv_text_secondary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputName" />

    <TextView
        android:id="@+id/categoryHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/profile_categories_hint"
        android:textColor="@color/sv_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/categoryLabel" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categoryGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="4dp"
        android:minHeight="80dp"
        android:nextFocusUp="@id/inputName"
        android:nextFocusDown="@id/avatarGrid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/categoryHint" />

    <TextView
        android:id="@+id/avatarLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/profile_avatar_pick"
        android:textColor="@color/sv_text_secondary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/categoryGrid" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/avatarGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="6dp"
        android:nextFocusUp="@id/categoryGrid"
        android:nextFocusDown="@id/btnSaveProfile"
        app:layout_constraintBottom_toTopOf="@id/actionRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/avatarLabel" />

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnSaveProfile"
            style="@style/SvButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="160dp"
            android:nextFocusUp="@id/avatarGrid"
            android:nextFocusRight="@id/btnDeleteProfile"
            android:text="@string/profile_save"
            android:textColor="@color/sv_primary_btn_text" />

        <Button
            android:id="@+id/btnDeleteProfile"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minWidth="140dp"
            android:nextFocusUp="@id/avatarGrid"
            android:nextFocusLeft="@id/btnSaveProfile"
            android:nextFocusRight="@id/btnCancelEdit"
            android:text="@string/profile_delete"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCancelEdit"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minWidth="120dp"
            android:nextFocusUp="@id/avatarGrid"
            android:nextFocusLeft="@id/btnDeleteProfile"
            android:text="@string/profile_cancel" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

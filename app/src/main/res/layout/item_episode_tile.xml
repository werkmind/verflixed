<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/episodeRow"
    android:layout_width="252dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_episode_card"
    android:clickable="true"
    android:clipToPadding="false"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/bg_card_focus"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/episodeStillWrap"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:clipChildren="true"
        android:clipToPadding="true">

        <ImageView
            android:id="@+id/episodeStill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_poster_surface"
            android:contentDescription="@null"
            android:focusable="false"
            android:scaleType="centerCrop"
            android:src="@drawable/poster_placeholder" />

        <ImageView
            android:id="@+id/episodeWatchedMark"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_watched_mark"
            android:contentDescription="@string/watched"
            android:focusable="false"
            android:padding="4dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/sv_watched" />

        <View
            android:id="@+id/episodeProgressTrack"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="#66000000"
            android:focusable="false"
            android:visibility="gone" />

        <View
            android:id="@+id/episodeProgressBar"
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="@color/sv_progress"
            android:focusable="false"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/episodeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:focusable="false"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/sv_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/episodeMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:focusable="false"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/sv_text_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/episodeOverview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:focusable="false"
        android:lineSpacingMultiplier="1.35"
        android:maxLines="2"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="4dp"
        android:textColor="@color/sv_text_secondary"
        android:textSize="13sp" />
</LinearLayout>

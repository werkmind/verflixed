<?xml version="1.0" encoding="utf-8"?>
<!-- Netflix-style episode tile: 16:9 still, number+title, short meta, 2-line synopsis. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/episodeRow"
    android:layout_width="232dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:background="@drawable/bg_episode_card"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="124dp"
        android:clipChildren="true"
        android:clipToPadding="true">

        <ImageView
            android:id="@+id/episodeStill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_poster_surface"
            android:contentDescription="@null"
            android:focusable="false"
            android:scaleType="centerCrop"
            android:src="@drawable/poster_placeholder" />

        <ImageView
            android:id="@+id/episodeWatchedMark"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_watched_mark"
            android:contentDescription="@string/watched"
            android:focusable="false"
            android:padding="5dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/sv_watched" />

        <View
            android:id="@+id/episodeProgressTrack"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="#66000000"
            android:focusable="false"
            android:visibility="gone" />

        <View
            android:id="@+id/episodeProgressBar"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="@color/sv_progress"
            android:focusable="false"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/episodeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:focusable="false"
        android:maxLines="1"
        android:textColor="@color/sv_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/streamReadyDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_stream_dot"
            android:focusable="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/episodeMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:focusable="false"
            android:maxLines="1"
            android:textColor="@color/sv_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/episodeOverview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:focusable="false"
        android:lineSpacingMultiplier="1.25"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@color/sv_text_secondary"
        android:textSize="12sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/sv_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_title"
            android:textColor="@color/sv_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/currentUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_episode_card"
            android:lineSpacingExtra="3dp"
            android:padding="18dp"
            android:textColor="@color/sv_text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inputUpdateUrl"
            style="@style/SvEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Update-Manifest URL (verflixed-update.json)"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnSaveUpdateUrl"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Update-URL speichern" />

        <Button
            android:id="@+id/btnCheckUpdate"
            style="@style/SvButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="@string/check_update"
            android:textColor="@color/sv_primary_btn_text" />

        <Button
            android:id="@+id/btnChangeUrl"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minWidth="220dp"
            android:text="@string/settings_change_url" />

        <Button
            android:id="@+id/btnClearCache"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="@string/settings_clear_cache" />

        <Button
            android:id="@+id/btnToggleLanguage"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="Profil-Ton: Deutsch" />

        <Button
            android:id="@+id/btnToggleNav"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="Layout: Sidebar" />

        <Button
            android:id="@+id/btnToggleLibraryView"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="Bibliothek: Kacheln" />

        <Button
            android:id="@+id/btnToggleZoom"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="@string/settings_zoom" />

        <Button
            android:id="@+id/btnToggleSounds"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="@string/settings_sounds_on" />

        <Button
            android:id="@+id/btnProfiles"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:minWidth="220dp"
            android:text="@string/profile_switcher" />
    </LinearLayout>
</ScrollView>

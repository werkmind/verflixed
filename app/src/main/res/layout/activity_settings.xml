<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/vf_edge_vertical"
    android:layout_marginBottom="@dimen/vf_edge_vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/vf_edge"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/vf_edge"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/SvHeroTitle"
            android:text="@string/settings_title"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/currentUrl"
            android:layout_width="wrap_content"
            android:minWidth="520dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_panel"
            android:lineSpacingExtra="10dp"
            android:padding="20dp"
            android:textColor="@color/sv_text_muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/settings_scale_title"
            android:fontFamily="@font/archivo_bold"
            android:textColor="@color/sv_text_primary"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_scale_hint"
            android:textColor="@color/sv_text_secondary"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:id="@+id/scaleScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/scaleRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/settings_group_updates"
            android:fontFamily="@font/archivo_bold"
            android:textColor="@color/sv_text_primary"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/inputUpdateUrl"
            style="@style/SvEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Update-Manifest URL (verflixed-update.json)"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnSaveUpdateUrl"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Update-URL speichern" />

        <Button
            android:id="@+id/btnCheckUpdate"
            style="@style/SvButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="@string/check_update"
            android:textColor="@color/sv_primary_btn_text" />

        <Button
            android:id="@+id/btnChangeUrl"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="@string/settings_change_url" />

        <Button
            android:id="@+id/btnClearCache"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="@string/settings_clear_cache" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/settings_group_profile"
            android:fontFamily="@font/archivo_bold"
            android:textColor="@color/sv_text_primary"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnToggleLanguage"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minWidth="220dp"
            android:text="Profil-Ton: Deutsch" />

        <Button
            android:id="@+id/btnToggleNav"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="Layout: Sidebar" />

        <Button
            android:id="@+id/btnToggleLibraryView"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="Bibliothek: Kacheln" />

        <Button
            android:id="@+id/btnToggleSounds"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="@string/settings_sounds_on" />

        <Button
            android:id="@+id/btnProfiles"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:text="@string/profile_switcher" />

        <Button
            android:id="@+id/btnProfileSync"
            style="@style/SvButton.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:minWidth="220dp"
            android:text="@string/settings_profile_sync" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/sv_poster_bg"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/poster_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_hero_gradient"
        app:layout_constraintBottom_toBottomOf="@id/backdrop"
        app:layout_constraintEnd_toEndOf="@id/backdrop"
        app:layout_constraintStart_toStartOf="@id/backdrop"
        app:layout_constraintTop_toTopOf="@id/backdrop" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_detail_scrim"
        app:layout_constraintBottom_toBottomOf="@id/backdrop"
        app:layout_constraintEnd_toEndOf="@id/backdrop"
        app:layout_constraintStart_toStartOf="@id/backdrop"
        app:layout_constraintTop_toTopOf="@id/backdrop" />

    <ImageView
        android:id="@+id/poster"
        android:layout_width="188dp"
        android:layout_height="282dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="24dp"
        android:adjustViewBounds="false"
        android:background="@drawable/bg_poster_card"
        android:contentDescription="@null"
        android:elevation="8dp"
        android:foreground="@drawable/bg_poster_focus"
        android:scaleType="centerCrop"
        android:src="@drawable/poster_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/cacheStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="@color/sv_text_secondary"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/poster"
        app:layout_constraintEnd_toEndOf="@id/poster"
        app:layout_constraintStart_toStartOf="@id/poster" />

    <TextView
        android:id="@+id/title"
        style="@style/SvHeroTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="40dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/poster"
        app:layout_constraintTop_toTopOf="@id/poster" />

    <TextView
        android:id="@+id/meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="40dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/sv_text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/poster"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <TextView
        android:id="@+id/overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="40dp"
        android:ellipsize="end"
        android:focusable="false"
        android:lineSpacingMultiplier="1.4"
        android:maxLines="3"
        android:textColor="@color/sv_text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/poster"
        app:layout_constraintTop_toBottomOf="@id/meta" />

    <TextView
        android:id="@+id/overviewMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_overview_focus"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/btnPlay"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="@string/detail_overview_more"
        android:textColor="@color/sv_text_link"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/poster"
        app:layout_constraintTop_toBottomOf="@id/overview" />

    <HorizontalScrollView
        android:id="@+id/actionsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="40dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/poster"
        app:layout_constraintTop_toBottomOf="@id/overviewMore">

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnPlay"
                style="@style/SvButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_play_arrow"
                android:drawablePadding="10dp"
                android:drawableTint="@color/sv_button_primary_text"
                android:minWidth="168dp"
                android:minHeight="48dp"
                android:nextFocusUp="@id/overviewMore"
                android:nextFocusDown="@id/seasonTabs"
                android:nextFocusRight="@id/btnFavorite"
                android:paddingStart="22dp"
                android:paddingTop="12dp"
                android:paddingEnd="26dp"
                android:paddingBottom="12dp"
                android:text="@string/detail_play" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/detail_my_list"
                android:nextFocusUp="@id/overviewMore"
                android:nextFocusDown="@id/seasonTabs"
                android:nextFocusLeft="@id/btnPlay"
                android:nextFocusRight="@id/btnRate"
                android:padding="9dp"
                android:src="@drawable/ic_star"
                app:tint="@color/sv_text_primary" />

            <ImageButton
                android:id="@+id/btnRate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/detail_rate_cd"
                android:nextFocusUp="@id/overviewMore"
                android:nextFocusDown="@id/seasonTabs"
                android:nextFocusLeft="@id/btnFavorite"
                android:nextFocusRight="@id/btnMore"
                android:padding="9dp"
                android:src="@drawable/ic_thumb_up"
                app:tint="@color/sv_text_primary" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/detail_more_menu_cd"
                android:nextFocusUp="@id/overviewMore"
                android:nextFocusDown="@id/seasonTabs"
                android:nextFocusLeft="@id/btnRate"
                android:padding="9dp"
                android:src="@drawable/ic_more_horiz"
                app:tint="@color/sv_text_primary" />

            <TextView
                android:id="@+id/actionHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:focusable="false"
                android:textColor="@color/sv_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/heroBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="poster,actionsScroll" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/seasonTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="28dp"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:nextFocusDown="@id/episodeList"
        android:nextFocusUp="@id/btnPlay"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heroBarrier" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/episodeList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@id/seasonTabs"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingTop="16dp"
        android:paddingEnd="40dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/seasonTabs" />

    <LinearLayout
        android:id="@+id/progress"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_app"
        android:clickable="true"
        android:elevation="40dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.streamvault.tv.ui.util.ShimmerHostView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="28dp"
            android:paddingEnd="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="188dp"
                    android:layout_height="282dp"
                    android:background="@drawable/bg_skeleton_card" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <View
                        android:layout_width="280dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="160dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="200dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="168dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_skeleton" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="220dp"
                android:layout_height="18dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_skeleton" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="252dp"
                    android:layout_height="236dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="252dp"
                    android:layout_height="236dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="252dp"
                    android:layout_height="236dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>
        </com.streamvault.tv.ui.util.ShimmerHostView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

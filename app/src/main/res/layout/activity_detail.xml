<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipChildren="true"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/sv_poster_bg"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/poster_placeholder"
        app:layout_constraintBottom_toBottomOf="@id/heroBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_hero_gradient"
        app:layout_constraintBottom_toBottomOf="@id/backdrop"
        app:layout_constraintEnd_toEndOf="@id/backdrop"
        app:layout_constraintStart_toStartOf="@id/backdrop"
        app:layout_constraintTop_toTopOf="@id/backdrop" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_detail_scrim"
        app:layout_constraintBottom_toBottomOf="@id/backdrop"
        app:layout_constraintEnd_toEndOf="@id/backdrop"
        app:layout_constraintStart_toStartOf="@id/backdrop"
        app:layout_constraintTop_toTopOf="@id/backdrop" />

    <ImageView
        android:id="@+id/poster"
        android:layout_width="128dp"
        android:layout_height="192dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="28dp"
        android:adjustViewBounds="false"
        android:background="@drawable/bg_poster_card"
        android:contentDescription="@null"
        android:elevation="8dp"
        android:foreground="@drawable/bg_poster_focus"
        android:scaleType="centerCrop"
        android:src="@drawable/poster_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title"
        style="@style/SvHeroTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="40dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/poster"
        app:layout_constraintTop_toTopOf="@id/poster" />

    <TextView
        android:id="@+id/meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="40dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/sv_text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/poster"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <TextView
        android:id="@+id/overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="40dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:textColor="@color/sv_text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/poster"
        app:layout_constraintTop_toBottomOf="@id/meta" />

    <HorizontalScrollView
        android:id="@+id/actionsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="40dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/poster"
        app:layout_constraintTop_toBottomOf="@id/overview">

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/btnPlay"
                style="@style/SvButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:drawableStart="@drawable/ic_play_arrow"
                android:drawablePadding="6dp"
                android:drawableTint="@color/sv_button_primary_text"
                android:minWidth="140dp"
                android:minHeight="44dp"
                android:nextFocusDown="@id/seasonTabs"
                android:nextFocusRight="@id/btnFavorite"
                android:paddingStart="14dp"
                android:paddingEnd="18dp"
                android:text="@string/detail_play" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/detail_my_list"
                android:nextFocusDown="@id/seasonTabs"
                android:nextFocusLeft="@id/btnPlay"
                android:nextFocusRight="@id/btnRate"
                android:padding="10dp"
                android:src="@drawable/ic_star"
                app:tint="@color/sv_text_primary" />

            <ImageButton
                android:id="@+id/btnRate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/detail_rate_cd"
                android:nextFocusDown="@id/seasonTabs"
                android:nextFocusLeft="@id/btnFavorite"
                android:nextFocusRight="@id/btnMore"
                android:padding="10dp"
                android:src="@drawable/ic_thumb_up"
                app:tint="@color/sv_text_primary" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/detail_more_menu_cd"
                android:nextFocusDown="@id/seasonTabs"
                android:nextFocusLeft="@id/btnRate"
                android:padding="10dp"
                android:src="@drawable/ic_more_horiz"
                app:tint="@color/sv_text_primary" />

            <TextView
                android:id="@+id/actionHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:focusable="false"
                android:textColor="@color/sv_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/heroBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="poster,actionsScroll" />

    <TextView
        android:id="@+id/cacheStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_status_pill"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@color/sv_text_secondary"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heroBarrier" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/seasonTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="34dp"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:descendantFocusability="afterDescendants"
        android:nextFocusDown="@id/episodeList"
        android:nextFocusUp="@id/btnPlay"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cacheStatus" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/episodeList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="42dp"
        android:paddingTop="8dp"
        android:paddingEnd="42dp"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@id/seasonTabs"
        android:orientation="horizontal"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/seasonTabs" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminateTint="@color/sv_accent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sv_bg"
    android:clipChildren="false">

    <!-- Compact top nav (scrollable) so Fire TV 720p keeps content visible -->
    <HorizontalScrollView
        android:id="@+id/navScroll"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/brandMark"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_verflixed_mark" />

            <ImageView
                android:id="@+id/profileAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/profile_switcher"
                android:focusable="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_verflixed_mark" />

            <TextView
                android:id="@+id/profileNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:ellipsize="end"
                android:focusable="true"
                android:maxWidth="120dp"
                android:maxLines="1"
                android:textColor="@color/sv_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tabLibrary"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:minHeight="36dp"
                android:text="@string/mode_library"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabBrowse"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:minHeight="36dp"
                android:text="@string/mode_browse"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tabSearch"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:minHeight="36dp"
                android:text="@string/mode_search"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnKindSeries"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:minHeight="36dp"
                android:text="@string/kind_series"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnKindMovies"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:minHeight="36dp"
                android:text="@string/kind_movies"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLoadMore"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:minHeight="36dp"
                android:text="@string/browse_more"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnProfile"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:minHeight="36dp"
                android:text="@string/profile_switcher"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnUpdate"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:minHeight="36dp"
                android:text="@string/check_update"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRefresh"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:minHeight="36dp"
                android:text="@string/settings_refresh"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:text="@string/home_settings"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Hero: max ~34% screen so rows stay visible on 720p Fire TV -->
    <FrameLayout
        android:id="@+id/heroContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="180dp"
        app:layout_constraintHeight_percent="0.26"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navScroll">

        <ImageView
            android:id="@+id/heroBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/poster_placeholder" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hero_gradient" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_detail_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/heroTitle"
                style="@style/SvHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Verflixed"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/heroMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/sv_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/heroOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/sv_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnHeroPlay"
                    style="@style/SvButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minHeight="40dp"
                    android:minWidth="120dp"
                    android:text="@string/detail_play"
                    android:textColor="@color/sv_primary_btn_text" />

                <Button
                    android:id="@+id/btnHeroInfo"
                    style="@style/SvButton.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:minHeight="40dp"
                    android:text="Details" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <EditText
        android:id="@+id/searchInput"
        style="@style/SvEditText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="false"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heroContainer" />

    <include
        layout="@layout/include_search_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navScroll" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/filterChips"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchInput" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rows"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:paddingTop="2dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heroContainer" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminateTint="@color/sv_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="@color/sv_text_secondary"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

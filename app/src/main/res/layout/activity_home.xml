<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipChildren="true"
    android:clipToPadding="false">

    <!-- ===== SIDEBAR (default) ===== -->
    <LinearLayout
        android:id="@+id/sideNav"
        android:layout_width="72dp"
        android:layout_height="0dp"
        android:background="#EE0A0D14"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:elevation="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/profileAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar_focus"
            android:contentDescription="@string/profile_switcher"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/navLibrary"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar_placeholder" />

        <TextView
            android:id="@+id/profileNameLabel"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:focusable="false"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/sv_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:layout_width="28dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="@color/sv_card_stroke" />

        <ImageButton
            android:id="@+id/navLibrary"
            style="@style/SvSideNavBtn"
            android:contentDescription="@string/mode_library"
            android:nextFocusUp="@id/profileAvatar"
            android:nextFocusDown="@id/navSeries"
            android:src="@drawable/ic_nav_library" />

        <ImageButton
            android:id="@+id/navSeries"
            style="@style/SvSideNavBtn"
            android:contentDescription="@string/kind_series"
            android:nextFocusUp="@id/navLibrary"
            android:nextFocusDown="@id/navMovies"
            android:src="@drawable/ic_nav_series" />

        <ImageButton
            android:id="@+id/navMovies"
            style="@style/SvSideNavBtn"
            android:contentDescription="@string/kind_movies"
            android:nextFocusUp="@id/navSeries"
            android:nextFocusDown="@id/navSearch"
            android:src="@drawable/ic_nav_movies" />

        <ImageButton
            android:id="@+id/navSearch"
            style="@style/SvSideNavBtn"
            android:contentDescription="@string/mode_search"
            android:nextFocusUp="@id/navMovies"
            android:nextFocusDown="@id/navUpdate"
            android:src="@drawable/ic_nav_search" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/navUpdate"
            style="@style/SvSideNavBtn"
            android:contentDescription="@string/check_update"
            android:nextFocusUp="@id/navSearch"
            android:nextFocusDown="@id/navSettings"
            android:src="@drawable/ic_nav_update" />

        <ImageButton
            android:id="@+id/navSettings"
            style="@style/SvSideNavBtn"
            android:contentDescription="@string/home_settings"
            android:nextFocusUp="@id/navUpdate"
            android:src="@drawable/ic_nav_settings" />
    </LinearLayout>

    <!-- ===== TOPBAR (optional per profile) ===== -->
    <HorizontalScrollView
        android:id="@+id/navScroll"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="24dp">

            <Button
                android:id="@+id/tabLibrary"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="@string/mode_library" />

            <Button
                android:id="@+id/tabBrowse"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="@string/kind_series" />

            <Button
                android:id="@+id/btnKindMovies"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="@string/kind_movies" />

            <Button
                android:id="@+id/tabSearch"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="14dp"
                android:text="@string/mode_search" />

            <Button
                android:id="@+id/btnUpdate"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="@string/check_update" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:text="@string/home_settings" />

            <Button
                android:id="@+id/btnProfile"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="@string/profile_switcher" />

            <!-- Kept for ViewBinding / legacy focus IDs -->
            <Button
                android:id="@+id/btnKindSeries"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLoadMore"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Legacy hero stubs (ViewBinding) -->
    <FrameLayout
        android:id="@+id/heroContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/heroBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroOverview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnHeroPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnHeroInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </FrameLayout>

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/filterChips"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/searchPanel"
        layout="@layout/include_search_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sideNav"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rows"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sideNav"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Skeleton shimmer row while loading -->
    <LinearLayout
        android:id="@+id/skeletonHost"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sideNav"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="180dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_skeleton" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <View
                android:layout_width="112dp"
                android:layout_height="160dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="112dp"
                android:layout_height="160dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="112dp"
                android:layout_height="160dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="112dp"
                android:layout_height="160dp"
                android:background="@drawable/bg_skeleton" />
        </LinearLayout>

        <View
            android:layout_width="140dp"
            android:layout_height="14dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_skeleton" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <View
                android:layout_width="112dp"
                android:layout_height="160dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="112dp"
                android:layout_height="160dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="112dp"
                android:layout_height="160dp"
                android:background="@drawable/bg_skeleton" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/sv_accent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sideNav"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="@color/sv_text_secondary"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sideNav"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

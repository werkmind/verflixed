<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sv_bg"
    android:clipChildren="true"
    android:clipToPadding="true">

    <!-- Compact top nav (scrollable) so Fire TV 720p keeps content visible. -->
    <HorizontalScrollView
        android:id="@+id/navScroll"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="36dp"
            android:paddingEnd="28dp">

            <ImageView
                android:id="@+id/profileAvatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_avatar_focus"
                android:contentDescription="@string/profile_switcher"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_placeholder" />

            <TextView
                android:id="@+id/profileNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_button_nav"
                android:ellipsize="end"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:maxWidth="120dp"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textAllCaps="true"
                android:textColor="@color/sv_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tabLibrary"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:text="@string/mode_library" />

            <Button
                android:id="@+id/tabBrowse"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:text="@string/mode_browse" />

            <Button
                android:id="@+id/tabSearch"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="14dp"
                android:text="@string/mode_search" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_marginEnd="14dp"
                android:background="@color/sv_card_stroke" />

            <Button
                android:id="@+id/btnKindSeries"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:text="@string/kind_series" />

            <Button
                android:id="@+id/btnKindMovies"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="14dp"
                android:text="@string/kind_movies" />

            <Button
                android:id="@+id/btnLoadMore"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:text="@string/browse_more"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnProfile"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:focusable="true"
                android:nextFocusRight="@id/btnUpdate"
                android:text="@string/profile_switcher" />

            <Button
                android:id="@+id/btnUpdate"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:focusable="true"
                android:nextFocusLeft="@id/btnProfile"
                android:nextFocusRight="@id/btnRefresh"
                android:text="@string/check_update" />

            <Button
                android:id="@+id/btnRefresh"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:focusable="true"
                android:nextFocusLeft="@id/btnUpdate"
                android:nextFocusRight="@id/btnSettings"
                android:text="@string/settings_refresh" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/SvButton.Nav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:focusable="true"
                android:nextFocusLeft="@id/btnRefresh"
                android:text="@string/home_settings" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Legacy fixed hero kept for ViewBinding IDs but GONE — real hero scrolls as list header. -->
    <FrameLayout
        android:id="@+id/heroContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navScroll">

        <ImageView
            android:id="@+id/heroBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/poster_placeholder" />

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroOverview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnHeroPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnHeroInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:visibility="gone" />
    </FrameLayout>

    <EditText
        android:id="@+id/searchInput"
        style="@style/SvEditText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="false"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navScroll" />

    <include
        layout="@layout/include_search_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navScroll" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/filterChips"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchInput" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rows"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:descendantFocusability="afterDescendants"
        android:paddingTop="4dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navScroll" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/sv_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="@color/sv_text_secondary"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

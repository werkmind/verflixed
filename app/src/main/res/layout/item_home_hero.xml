<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heroContainer"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:focusable="false">

    <ImageView
        android:id="@+id/heroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sv_poster_bg"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/poster_placeholder" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_gradient" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_detail_scrim" />

    <LinearLayout
        android:id="@+id/heroTextBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/heroKicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:letterSpacing="0.22"
            android:textAllCaps="true"
            android:textColor="@color/sv_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heroTitle"
            style="@style/SvHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Verflixed"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sv_text_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/heroOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.4"
            android:maxLines="3"
            android:maxWidth="640dp"
            android:textColor="@color/sv_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnHeroPlay"
                style="@style/SvButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_play_arrow"
                android:drawablePadding="10dp"
                android:drawableTint="@color/sv_button_primary_text"
                android:minWidth="168dp"
                android:nextFocusUp="@id/tabBrowse"
                android:nextFocusRight="@id/btnHeroInfo"
                android:paddingStart="22dp"
                android:paddingEnd="26dp"
                android:text="@string/detail_play" />

            <ImageButton
                android:id="@+id/btnHeroInfo"
                style="@style/SvTopbarIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:contentDescription="@string/detail_more_info"
                android:nextFocusUp="@id/tabBrowse"
                android:nextFocusLeft="@id/btnHeroPlay"
                android:padding="12dp"
                android:src="@drawable/ic_info" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

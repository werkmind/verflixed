<?xml version="1.0" encoding="utf-8"?>
<!-- Facts and actions of the focused title, over the fixed billboard. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heroContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:focusable="false"
    android:minHeight="300dp">

    <!-- The artwork is the fixed billboard behind the feed; this item only
         carries the title's facts and actions. Kept for the view holder. -->
    <ImageView
        android:id="@+id/heroBackdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/heroTextBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/vf_edge"
        android:paddingTop="76dp"
        android:paddingEnd="@dimen/vf_edge"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/heroKicker"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroTitle"
            style="@style/SvHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="560dp"
            android:maxLines="2"
            android:textSize="52sp"
            android:shadowColor="#99000000"
            android:shadowDy="3"
            android:shadowRadius="18"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/archivo_medium"
            android:maxLines="1"
            android:textColor="@color/sv_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/heroOverview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.35"
            android:maxWidth="520dp"
            android:maxLines="3"
            android:textColor="@color/sv_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnHeroPlay"
                style="@style/SvButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_play_arrow"
                android:drawablePadding="8dp"
                android:drawableTint="@color/sv_primary_btn_text"
                android:minWidth="160dp"
                android:nextFocusRight="@id/btnHeroInfo"
                android:nextFocusUp="@id/tabBrowse"
                android:text="@string/detail_play" />

            <ImageButton
                android:id="@+id/btnHeroInfo"
                style="@style/SvTopbarIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/detail_more_info"
                android:nextFocusLeft="@id/btnHeroPlay"
                android:nextFocusUp="@id/tabBrowse"
                android:padding="12dp"
                android:src="@drawable/ic_info" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

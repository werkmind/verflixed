<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heroContainer"
    android:layout_width="match_parent"
    android:layout_height="168dp"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:focusable="false"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/heroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sv_poster_bg"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/poster_placeholder" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_gradient" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_detail_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="true"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/heroTitle"
            style="@style/SvHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Verflixed"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sv_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heroOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:maxWidth="620dp"
            android:textColor="@color/sv_text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHeroPlay"
                style="@style/SvButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="38dp"
                android:minWidth="132dp"
                android:nextFocusUp="@id/tabBrowse"
                android:nextFocusRight="@id/btnHeroInfo"
                android:text="@string/detail_play" />

            <Button
                android:id="@+id/btnHeroInfo"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:minHeight="38dp"
                android:minWidth="104dp"
                android:nextFocusUp="@id/tabBrowse"
                android:nextFocusLeft="@id/btnHeroPlay"
                android:text="@string/detail_more_info" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

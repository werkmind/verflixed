<?xml version="1.0" encoding="utf-8"?>
<!-- Profile tile: the avatar is the artwork and takes focus like any tile. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="28dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:focusable="false"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/profileSelectArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:nextFocusDown="@id/btnEdit"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/posterFrame"
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:background="@drawable/bg_panel"
            android:duplicateParentState="true"
            android:foreground="@drawable/bg_card_focus">

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="14dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_verflixed_mark" />
        </FrameLayout>

        <TextView
            android:id="@+id/profileName"
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:fontFamily="@font/archivo_bold"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/sv_tile_title"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/profileMeta"
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/sv_accent"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnEdit"
        style="@style/SvButton.Ghost"
        android:layout_width="148dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="44dp"
        android:nextFocusUp="@id/profileSelectArea"
        android:text="@string/profile_edit"
        android:textSize="14sp" />

    <!-- Selecting happens on the tile itself. Kept for the adapter. -->
    <Button
        android:id="@+id/btnSelect"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>

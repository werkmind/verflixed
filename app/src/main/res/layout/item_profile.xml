<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_episode_card"
    android:descendantFocusability="afterDescendants"
    android:focusable="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <ImageView
        android:id="@+id/avatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_verflixed_mark" />

    <LinearLayout
        android:id="@+id/profileSelectArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:nextFocusRight="@id/btnEdit"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/profileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sv_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profileMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/sv_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnEdit"
        style="@style/SvButton.Ghost"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minHeight="40dp"
        android:nextFocusLeft="@id/profileSelectArea"
        android:nextFocusRight="@id/btnSelect"
        android:text="@string/profile_edit"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnSelect"
        style="@style/SvButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:minHeight="40dp"
        android:nextFocusLeft="@id/btnEdit"
        android:text="@string/profile_switch"
        android:textColor="@color/sv_primary_btn_text"
        android:textSize="12sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sv_bg_deep"
    android:padding="48dp">

    <LinearLayout
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/sv_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/setup_title"
            android:textColor="@color/sv_text_primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/setup_subtitle"
            android:textColor="@color/sv_text_secondary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/inputBaseUrl"
            style="@style/SvEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="@string/setup_hint_series"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:nextFocusDown="@id/inputMoviesBaseUrl" />

        <EditText
            android:id="@+id/inputMoviesBaseUrl"
            style="@style/SvEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/setup_hint_movies"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:nextFocusDown="@id/inputTmdbKey" />

        <EditText
            android:id="@+id/inputTmdbKey"
            style="@style/SvEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/setup_tmdb_hint"
            android:imeOptions="actionDone"
            android:inputType="textVisiblePassword"
            android:nextFocusDown="@id/btnContinue" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/sv_accent"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnContinue"
            style="@style/SvButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="180dp"
            android:text="@string/setup_continue"
            android:textColor="@color/sv_primary_btn_text" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/sv_accent"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- TV: the row container must never take focus itself - if the row grabs the
     D-pad focus, posters become unreachable and focus can die entirely. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <TextView
        android:id="@+id/rowTitle"
        style="@style/SvRowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vf_edge" />

    <!-- Padding, not margin, so tiles scroll out under the screen edge and a
         focused tile has room to grow without being cut. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rowList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:nestedScrollingEnabled="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vf_edge"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/vf_edge"
        android:paddingBottom="12dp" />
</LinearLayout>

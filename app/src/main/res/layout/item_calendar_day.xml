<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="156dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_episode_card"
    android:clickable="true"
    android:clipToPadding="false"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/bg_poster_focus"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/calWeekday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="@color/sv_text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/calDay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="@color/sv_text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/calPoster"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_poster_surface"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/poster_placeholder" />

    <TextView
        android:id="@+id/calTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/sv_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/calEpisode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/sv_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/calBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_poster_badge"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="@color/sv_text_primary"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>

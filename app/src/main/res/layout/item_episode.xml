<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/episodeRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_episode_card"
    android:clickable="true"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="168dp"
        android:layout_height="94dp"
        android:clipChildren="true"
        android:clipToPadding="true">

        <ImageView
            android:id="@+id/episodeStill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="false"
            android:background="@drawable/bg_poster_surface"
            android:contentDescription="@null"
            android:focusable="false"
            android:scaleType="centerCrop"
            android:src="@drawable/poster_placeholder" />

        <View
            android:id="@+id/episodeProgressTrack"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="#66000000"
            android:focusable="false"
            android:visibility="gone" />

        <View
            android:id="@+id/episodeProgressBar"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:background="@color/sv_progress"
            android:focusable="false"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/episodeNumber"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:focusable="false"
        android:textColor="@color/sv_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:focusable="false"
        android:orientation="vertical">

        <TextView
            android:id="@+id/episodeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:focusable="false"
            android:maxLines="1"
            android:textColor="@color/sv_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/episodeMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:focusable="false"
            android:maxLines="2"
            android:textColor="@color/sv_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/watchedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_season_chip"
        android:clickable="false"
        android:focusable="false"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:textColor="@color/sv_watched"
        android:textSize="12sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/streamReadyDot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_stream_dot"
        android:focusable="false"
        android:visibility="gone" />
</LinearLayout>

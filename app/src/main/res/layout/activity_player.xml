<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:keepScreenOn="true"
        android:visibility="gone"
        app:show_buffering="when_playing"
        app:show_timeout="5000"
        app:use_controller="true" />

    <WebView
        android:id="@+id/webPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:keepScreenOn="true"
        android:visibility="gone" />

    <!-- Chrome ABOVE WebView so HLS/Web switch stays usable with D-pad -->
    <FrameLayout
        android:id="@+id/playerChrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:elevation="28dp"
        android:translationZ="28dp">

        <ProgressBar
            android:id="@+id/playerLoading"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/sv_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/resolveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@color/sv_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/modeBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnLangToggle"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:minHeight="40dp"
                android:minWidth="72dp"
                android:text="DE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnRetryHls"
                style="@style/SvButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:minWidth="130dp"
                android:text="HLS Player"
                android:textColor="@color/sv_primary_btn_text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnUseWebPlayer"
                style="@style/SvButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:minHeight="40dp"
                android:minWidth="130dp"
                android:text="Web-Player"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/playerErrorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/playerError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/sv_text_primary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/playerActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nextEpisodeBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="36dp"
            android:background="@drawable/bg_card"
            android:elevation="20dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/nextEpisodeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/player_next"
                android:textColor="@color/sv_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nextEpisodeCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/sv_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSkipNextPrompt"
                    style="@style/SvButton.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:minHeight="44dp"
                    android:minWidth="140dp"
                    android:nextFocusRight="@id/btnPlayNext"
                    android:text="@string/player_skip_credits" />

                <Button
                    android:id="@+id/btnPlayNext"
                    style="@style/SvButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:minHeight="44dp"
                    android:minWidth="180dp"
                    android:nextFocusLeft="@id/btnSkipNextPrompt"
                    android:text="@string/player_next"
                    android:textColor="@color/sv_primary_btn_text" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

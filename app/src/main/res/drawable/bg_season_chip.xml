<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF6FB2FF"
                android:endColor="#FF3D8BFF" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:color="@color/sv_focus_ring_soft" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF3F8CFF"
                android:endColor="#FF2568D8" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#4A3F8CFF"
                android:endColor="#2E2F80FF" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:color="@color/sv_focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1AFFFFFF"
                android:endColor="#0AFFFFFF" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#22FFFFFF" />
        </shape>
    </item>
</selector>

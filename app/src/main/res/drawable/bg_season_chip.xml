<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_accent_hover" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:color="@color/sv_focus_ring_soft" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_focus_fill" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:color="@color/sv_focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_card_fill" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/sv_card_stroke" />
        </shape>
    </item>
</selector>

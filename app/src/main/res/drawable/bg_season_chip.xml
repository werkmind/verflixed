<?xml version="1.0" encoding="utf-8"?>
<!-- Selector, not a CTA. Selected = surface. Accent fill is reserved for Play. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_surface_elevated" />
            <corners android:radius="@dimen/vf_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/sv_focus_ring" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_surface_elevated" />
            <corners android:radius="@dimen/vf_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_focus_fill" />
            <corners android:radius="@dimen/vf_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/sv_focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/vf_radius" />
        </shape>
    </item>
</selector>

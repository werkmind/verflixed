<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_accent_pressed" />
            <corners android:radius="@dimen/vf_radius_pill" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/sv_surface_elevated" />
                    <corners android:radius="@dimen/vf_radius_pill" />
                </shape>
            </item>
            <item
                android:bottom="20dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#28FFFFFF" />
                    <corners android:radius="@dimen/vf_radius_pill" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/sv_surface_elevated" />
                    <corners android:radius="@dimen/vf_radius_pill" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/sv_card_stroke" />
                </shape>
            </item>
            <item
                android:bottom="22dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#18FFFFFF" />
                    <corners android:radius="@dimen/vf_radius_pill" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

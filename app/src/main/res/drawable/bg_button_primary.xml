<?xml version="1.0" encoding="utf-8"?>
<!-- Modern CTA: solid white pill, dark label. No gradient, no sheen.
     Focus = 2dp ring + the shared focus scale; press = flat press color. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_btn_primary_pressed" />
            <corners android:radius="@dimen/vf_radius_pill" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/sv_btn_primary" />
                    <corners android:radius="@dimen/vf_radius_pill" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="@dimen/vf_radius_pill" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/sv_focus_ring" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/sv_btn_primary" />
                    <corners android:radius="@dimen/vf_radius_pill" />
                </shape>
            </item>
            <item android:top="20dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#00DDE3EC"
                        android:endColor="#26AAB4C6" />
                    <corners android:radius="@dimen/vf_radius_pill" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

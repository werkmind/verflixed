<?xml version="1.0" encoding="utf-8"?>
<!-- Focus ring for 14dp-corner cards (episode tiles, calendar day tiles).
     Midnight Cinema Glow: weißer Kern + Eis-Halo, konzentrisch zur Kachel. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bg_glow_focus_card" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/vf_radius" />
        </shape>
    </item>
</selector>

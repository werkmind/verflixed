<?xml version="1.0" encoding="utf-8"?>
<!--
  Stateful on purpose: a non-stateful background makes the platform draw its own
  default (near-white) focus highlight on TV. Both states are dark plates.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_surface" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_poster_bg" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>

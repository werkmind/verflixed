<?xml version="1.0" encoding="utf-8"?>
<!-- Ground with depth: near-black, lit from the upper right in the brand's deep blue. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_bg_deep" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.85" android:centerY="0.0" android:gradientRadius="75%p"
                android:startColor="#66163A7A" android:centerColor="#260F2247" android:endColor="#00050608" />
        </shape>
    </item>
</layer-list>

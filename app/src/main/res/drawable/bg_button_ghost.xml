<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet button and toggle: selected carries the accent frame. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_focus_pressed" />
            <corners android:radius="@dimen/vf_radius_control" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#FFE3E9F5" />
            <corners android:radius="@dimen/vf_radius_control" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_accent_soft" />
            <corners android:radius="@dimen/vf_radius_control" />
            <stroke android:width="2dp" android:color="@color/sv_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_glass" />
            <corners android:radius="@dimen/vf_radius_control" />
            <stroke android:width="1dp" android:color="@color/sv_glass_edge" />
        </shape>
    </item>
</selector>

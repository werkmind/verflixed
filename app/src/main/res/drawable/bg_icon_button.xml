<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/sv_accent_soft" />
            <stroke
                android:width="2dp"
                android:color="@color/sv_accent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/sv_focus_fill" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/sv_surface_elevated" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/sv_surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/sv_card_stroke" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Circular icon action: translucent dark glass disc at rest, glass capsule
     with ring on focus. Reads over hero imagery without hard borders. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/sv_accent_soft" />
        </shape>
    </item>
    <item android:state_focused="true" android:drawable="@drawable/bg_glass_focus_oval" />
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#9910141C" />
                    <stroke
                        android:width="1dp"
                        android:color="#26FFFFFF" />
                </shape>
            </item>
            <item android:bottom="22dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#1FFFFFFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

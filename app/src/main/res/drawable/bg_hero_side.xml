<?xml version="1.0" encoding="utf-8"?>
<!-- Vignette over the billboard: dark on the left for the title, clear by the
     middle, with a soft top edge for the nav. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:centerX="0.42"
                android:startColor="#E6050608" android:centerColor="#40050608" android:endColor="#00050608" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:centerY="0.22"
                android:startColor="#99050608" android:centerColor="#00050608" android:endColor="#00050608" />
        </shape>
    </item>
</layer-list>

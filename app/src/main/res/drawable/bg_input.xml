<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_surface_elevated" />
            <corners android:radius="@dimen/vf_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/sv_focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_surface" />
            <corners android:radius="@dimen/vf_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/sv_card_stroke" />
        </shape>
    </item>
</selector>

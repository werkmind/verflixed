<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark skeleton plate. Replaces the old white PNG, which flashed as white strips
  behind poster art while Glide was still loading. No intrinsic size, so it fills
  any ImageView (poster, backdrop, episode still) without cropping artefacts.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="@color/sv_poster_bg"
        android:endColor="@color/sv_bg_deep"
        android:startColor="@color/sv_surface_elevated"
        android:type="linear" />
</shape>

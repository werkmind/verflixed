<?xml version="1.0" encoding="utf-8"?>
<!-- Artwork focus: a white frame on the image edge. No rest outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/vf_radius_image" />
            <stroke android:width="@dimen/vf_focus_stroke" android:color="@color/sv_focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/vf_radius_image" />
        </shape>
    </item>
</selector>

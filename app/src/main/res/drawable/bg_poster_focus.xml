<?xml version="1.0" encoding="utf-8"?>
<!-- Artwork tiles carry no rest outline — the image is the card (no double edge).
     Focus: Midnight Cinema Glow (weißer Kern + Eis-Halo). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/bg_glow_focus" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/vf_radius_image" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Top-nav item: pure text at rest (Netflix style — active = white label).
     Focus = soft glass pill + ring; press = accent tint. No borders anywhere. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_accent_soft" />
            <corners android:radius="@dimen/vf_radius_pill" />
        </shape>
    </item>
    <item android:state_focused="true" android:drawable="@drawable/bg_glass_focus" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/vf_radius_pill" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Top-nav pill: invisible at rest, accent capsule on focus (Apple-TV style). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_accent_soft" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_focus_fill" />
            <corners android:radius="17dp" />
            <stroke
                android:width="2dp"
                android:color="@color/sv_focus_ring" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sv_card_fill" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</selector>

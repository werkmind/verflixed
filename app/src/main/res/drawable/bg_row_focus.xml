<?xml version="1.0" encoding="utf-8"?>
<!-- Selectable list row: glass at rest, lit white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#FFE3E9F5" />
            <corners android:radius="@dimen/vf_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="@dimen/vf_radius" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Deep-liquid glass capsule (focus state for nav pills):
     translucent fill + top sheen + inner hairline highlight + 2dp focus ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#402A3450" />
            <corners android:radius="@dimen/vf_radius_pill" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="22dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#30FFFFFF" />
            <corners android:radius="@dimen/vf_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/vf_radius_pill" />
            <stroke
                android:width="2dp"
                android:color="@color/sv_focus_ring" />
        </shape>
    </item>
</layer-list>

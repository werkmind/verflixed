<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay card (next-episode banner, captcha hint): dark glass over video. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F2202A40"
                android:endColor="#F2141B2C" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/sv_focus_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#EE1B2334"
                android:endColor="#EE10141F" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>

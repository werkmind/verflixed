<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Verflixed" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/sv_bg</item>
        <item name="android:colorPrimary">@color/sv_accent</item>
        <item name="colorPrimary">@color/sv_accent</item>
        <item name="colorPrimaryDark">@color/sv_bg_deep</item>
        <item name="colorAccent">@color/sv_accent</item>
        <item name="android:colorAccent">@color/sv_accent</item>
        <item name="android:textColorPrimary">@color/sv_text_primary</item>
        <item name="android:textColorSecondary">@color/sv_text_secondary</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/sv_bg_deep</item>
        <item name="android:navigationBarColor">@color/sv_bg_deep</item>
    </style>

    <style name="SvButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:backgroundTintMode">src_over</item>
        <item name="android:textColor">@color/sv_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <style name="SvButton.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>

    <style name="SvButton.Ghost">
        <item name="android:background">@drawable/bg_button_ghost</item>
    </style>

    <style name="SvEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/sv_text_primary</item>
        <item name="android:textColorHint">@color/sv_text_muted</item>
        <item name="android:padding">18dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SvRowTitle">
        <item name="android:textColor">@color/sv_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="SvHeroTitle">
        <item name="android:textColor">@color/sv_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">6</item>
    </style>
</resources>
